# GigWave environment variables – copy to .env and set real values. Never commit .env.
# Docker Compose reads .env from project root. For local backend run, export these or use IDE env.

# MongoDB Atlas (use your Atlas URI here; else Docker uses local MongoDB)
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@cluster0.xxxxx.mongodb.net/gigwave_prod?retryWrites=true&w=majority&appName=Cluster0
MONGODB_DATABASE=gigwave_prod

# JWT – generate: openssl rand -base64 32
JWT_SECRET=your-256-bit-secret-minimum-32-characters

# OnePipe
ONEPIPE_API_KEY=
ONEPIPE_SECRET_KEY=
ONEPIPE_BASE_URL=https://api.onepipe.io/v2/transact
ONEPIPE_ENV=sandbox
ONEPIPE_BILLER_CODE=

# File storage: local | imagekit. Use imagekit only when keys below are set.
FILE_STORAGE_TYPE=local
# ImageKit (url endpoint = e.g. https://ik.imagekit.io/your-id)
IMAGEKIT_URL_ENDPOINT=
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=

# Platform settlement/account (required for prod; dev/test use placeholders in profile config)
# EnvLoader loads .env → system properties; application.yml ${VAR} reads these. PaymentService uses platform.settlement.* / platform.account.*.
# Fidelity Bank code: 070. Replace account numbers with your actual NUBAN.
PLATFORM_SETTLEMENT_NUMBER=0000000000
PLATFORM_SETTLEMENT_BANK_CODE=070
PLATFORM_SETTLEMENT_NAME=Agbaosi Bolarinwa Minasu
PLATFORM_ACCOUNT_NUMBER=0000000000
PLATFORM_ACCOUNT_BANK_CODE=070
PLATFORM_ACCOUNT_NAME=Agbaosi Bolarinwa Minasu
PLATFORM_FEE_AMOUNT=200

# Optional: Flutterwave, Termii, CORS, etc.
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_ENABLED=false
TERMII_API_KEY=
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
SPRING_PROFILES_ACTIVE=dev

# Frontend .env – copy to .env and fill in your values.
# Vite only reads VITE_* vars. Restart dev server after changing .env.
# Never commit .env or put real keys in docs.

# API base URL (no trailing slash). Used when calling the backend.
# Local dev: leave empty to use Vite proxy (localhost:8080).
# Production: your deployed backend, e.g. https://gigwave-production.up.railway.app
VITE_API_BASE_URL=

# Google Maps API key – for LocationMap on gig details.
# Get one at: https://console.cloud.google.com/apis/credentials
VITE_GOOGLE_MAPS_API_KEY=
